layout {
    gaps 16
    center-focused-column "never"
    background-color "transparent"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }
    default-column-width {
        proportion 1.0
    }
    focus-ring {
        on
        width 4
        active-color "#8AFFC5"
        inactive-color "#505050"
        urgent-color "#9b0000"
    }
}

